            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3.5 mb-4 border-b border-slate-100 dark:border-slate-700/70">
                <div class="flex flex-wrap items-center gap-2.5">
                    <span class="flex h-3 w-3 relative">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-teal-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-3 w-3 bg-teal-500"></span>
                    </span>
                    <h2 class="text-base sm:text-lg font-bold text-slate-800 dark:text-white">
                        Lịch Học Nhanh: Hôm Nay & Ngày Mai
                    </h2>
                    <span id="widget-group-label" class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-blue-100 text-blue-700 dark:bg-blue-900/50 dark:text-blue-300">
                        Cả lớp RM31.03
                    </span>
