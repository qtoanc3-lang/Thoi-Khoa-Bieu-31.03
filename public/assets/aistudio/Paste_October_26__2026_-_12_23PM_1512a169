    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        /* Thanh cuộn tùy chỉnh */
        .custom-scrollbar::-webkit-scrollbar {
            height: 8px;
            width: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: rgba(148, 163, 184, 0.15);
            border-radius: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(100, 116, 139, 0.4);
            border-radius: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: rgba(100, 116, 139, 0.65);
        }

        /* Hiệu ứng highlight cột ngày hôm nay */
        .today-col-header {
            position: relative;
            background: linear-gradient(180deg, rgba(37, 99, 235, 0.14) 0%, rgba(37, 99, 235, 0.04) 100%) !important;
            border-top: 4px solid #2563eb !important;
        }
        .dark .today-col-header {
            background: linear-gradient(180deg, rgba(59, 130, 246, 0.25) 0%, rgba(59, 130, 246, 0.08) 100%) !important;
            border-top: 4px solid #60a5fa !important;
        }
        .today-col-cell {
            background-color: rgba(239, 246, 255, 0.65) !important;
        }
        .dark .today-col-cell {
            background-color: rgba(30, 58, 138, 0.18) !important;
        }

        /* Tối ưu khi in A4 */
        @page {
            size: A4 landscape; /* Ép khổ A4 nằm ngang để đủ 7 cột TKB */
            margin: 6mm 8mm;    /* Thu gọn lề giấy */
        }

        @media print {
            /* 1. Giữ nguyên màu sắc môn học và ép tỷ lệ vừa trang A4 */
            html, body {
                background: #ffffff !important;
                color: #000000 !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
                zoom: 82%; /* Thu nhỏ tự động để toàn bộ TKB nằm gọn trong 1 mặt A4 */
            }

            /* 2. Mở khóa toàn bộ khung cuộn ngang (overflow) đang làm mất cột TKB */
            *, *::before, *::after {
                overflow: visible !important;
                max-height: none !important;
            }

            /* 3. Ép bảng TKB co giãn vừa khít 100% khổ giấy A4 thay vì tràn lề */
            table {
                width: 100% !important;
                min-width: 0 !important;
                max-width: 100% !important;
                table-layout: fixed !important;
                border-collapse: collapse !important;
            }

            th, td {
                word-break: break-word !important;
                white-space: normal !important;
                padding: 4px !important;
                page-break-inside: avoid !important;
                break-inside: avoid !important;
            }

            /* 4. Tắt thanh neo (sticky) và ẩn nút bấm/ô tìm kiếm để không đẩy lệch trang */
            header, nav, .sticky, .fixed {
                position: static !important;
            }
            button, input, select, .no-print {
                display: none !important;
            }
            .print-only {
                display: block !important;
            }
            #table-view-container {
                display: block !important;
                box-shadow: none !important;
                border: 1px solid #cbd5e1 !important;
            }
            #card-view-container {
                display: none !important;
            }
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 dark:bg-slate-900 dark:text-slate-100 min-h-screen flex flex-col transition-colors duration-200">

    <!-- Thông báo Toast (Thay thế hoàn toàn alert) -->
