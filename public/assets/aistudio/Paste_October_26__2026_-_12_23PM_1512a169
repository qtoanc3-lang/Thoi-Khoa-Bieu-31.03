        function clearStudentSearch() {
            document.getElementById('student-search-input').value = '';
            renderStudentModalList();
        }

        function getFilteredStudentsForModal() {
            const rawQuery = (document.getElementById('student-search-input')?.value || '').trim();
            const clearBtn = document.getElementById('clear-student-search');
            if (clearBtn) {
                clearBtn.classList.toggle('hidden', rawQuery.length === 0);
            }

            const qNorm = removeVietnameseTones(rawQuery);

            return STUDENTS_DATA.filter(st => {
                if (state.studentModalTab !== 'all' && st.group !== state.studentModalTab) return false;
                if (!qNorm) return true;
                const fullName = `${st.lastName} ${st.firstName}`;
                const fullNorm = removeVietnameseTones(fullName);
                return fullNorm.includes(qNorm) || st.id.includes(qNorm);
            });
        }

        function renderStudentModalList() {
            const tbody = document.getElementById('student-modal-tbody');
            const list = getFilteredStudentsForModal();

            if (list.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" class="py-8 text-center text-slate-400 dark:text-slate-500">
                            Không tìm thấy sinh viên nào khớp với từ khóa tìm kiếm.
                        </td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = list.map((st, idx) => {
                const isSelected = state.myStudentId === st.id;
                const groupBadgeClass = st.group === 'nhom5'
                    ? 'bg-blue-100 text-blue-800 dark:bg-blue-900/60 dark:text-blue-200'
                    : 'bg-teal-100 text-teal-800 dark:bg-teal-900/60 dark:text-teal-200';

                return `
                    <tr class="${isSelected ? 'bg-teal-50/90 dark:bg-teal-950/40' : 'hover:bg-slate-50 dark:hover:bg-slate-700/40'} transition">
                        <td class="py-2.5 px-3 text-center font-semibold text-slate-500 dark:text-slate-400">
                            ${st.stt}
                        </td>
                        <td class="py-2.5 px-3 font-mono text-xs">
                            <div class="flex items-center gap-1.5">
                                <span class="font-semibold text-slate-700 dark:text-slate-200">${st.id}</span>
                                <button onclick="copyStudentId('${st.id}')" title="Sao chép Mã SV" class="text-slate-400 hover:text-blue-600 dark:hover:text-blue-400">
                                    <i class="fa-regular fa-copy text-[11px]"></i>
                                </button>
                            </div>
                        </td>
                        <td class="py-2.5 px-3 text-slate-700 dark:text-slate-300">
                            ${st.lastName}
                        </td>
                        <td class="py-2.5 px-3 font-bold text-slate-900 dark:text-white">
                            ${st.firstName}
                        </td>
                        <td class="py-2.5 px-3 text-center">
                            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold ${groupBadgeClass}">
                                ${st.groupLabel}
                            </span>
                        </td>
                        <td class="py-2.5 px-3 text-right">
                            ${isSelected ? `
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-teal-600 text-white text-xs font-bold">
                                    <i class="fa-solid fa-check"></i> Đang chọn
                                </span>
                            ` : `
                                <button onclick="selectMyStudent('${st.id}')" class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-blue-600 hover:text-white dark:bg-slate-700 dark:hover:bg-blue-600 text-slate-700 dark:text-slate-200 text-xs font-semibold transition">
                                    Chọn làm lịch của tôi
                                </button>
                            `}
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function copyStudentId(id) {
            copyTextToClipboard(id);
            showToast(`Đã sao chép Mã SV: ${id}`, 'success');
        }

        function copyCurrentStudentList() {
            const list = getFilteredStudentsForModal();
            if (list.length === 0) {
                showToast('Không có sinh viên nào trong danh sách để sao chép.', 'info');
                return;
            }
            const title = state.studentModalTab === 'all'
                ? 'DANH SÁCH LỚP RM31.03 (NHÓM 5 & NHÓM 6 - 27 SV)'
                : (state.studentModalTab === 'nhom5' ? 'DANH SÁCH NHÓM 5 - LỚP RM31.03 (14 SV)' : 'DANH SÁCH NHÓM 6 - LỚP RM31.03 (13 SV)');

            let lines = [`📋 ${title}:`, `Học phần: Thực hành Hóa học (Mã HP: 191393024)`];
            list.forEach(st => {
                lines.push(`${st.stt}. ${st.id} - ${st.lastName} ${st.firstName} (${st.groupLabel})`);
            });
            copyTextToClipboard(lines.join('\n'));
            showToast(`Đã sao chép danh sách ${list.length} sinh viên!`, 'success');
        }

        function selectMyStudent(studentId) {
            const st = STUDENTS_DATA.find(s => s.id === studentId);
            if (!st) return;
            state.myStudentId = st.id;
            localStorage.setItem('rm3103_my_student', st.id);
            setGroupFilter(st.group);
            renderPersonalStudentBanner();
            renderStudentModalList();
            closeStudentModal();
            showToast(`Đã cài đặt lịch cá nhân của ${st.lastName} ${st.firstName} (${st.groupLabel})!`, 'success');
        }

        function clearPersonalStudent() {
            state.myStudentId = null;
            localStorage.removeItem('rm3103_my_student');
            renderPersonalStudentBanner();
            renderStudentModalList();
            showToast('Đã tắt chế độ cá nhân hóa sinh viên.', 'info');
        }

        function renderPersonalStudentBanner() {
            const banner = document.getElementById('personal-student-banner');
            if (!state.myStudentId) {
                banner.classList.add('hidden');
                return;
            }
            const st = STUDENTS_DATA.find(s => s.id === state.myStudentId);
            if (!st) {
                banner.classList.add('hidden');
                return;
            }

            banner.classList.remove('hidden');
            document.getElementById('personal-student-name').textContent = `${st.lastName} ${st.firstName}`;
            document.getElementById('personal-student-id').textContent = `MSV: ${st.id}`;
            document.getElementById('personal-student-group').textContent = `${st.groupLabel} • RM31.03`;

            const labSummary = st.group === 'nhom5'
                ? 'Lịch thực hành của bạn: TH Hóa học Chiều Thứ Tư (P. C606) • TH Giải phẫu Sáng Thứ Năm (P. C402)'
                : 'Lịch thực hành của bạn: TH Hóa học Chiều Thứ Ba (P. C606) • TH Giải phẫu Chiều Thứ Tư (P. C402)';
            document.getElementById('personal-student-lab-summary').textContent = labSummary;
        }

        // =========================================================================
        // 5. KHỞI TẠO VÀ ĐIỀU KHIỂN BỘ LỌC THỜI KHÓA BIỂU
        // =========================================================================
        function initWeekSelector() {
            const select = document.getElementById('week-selector');
            select.innerHTML = WEEKS_DATA.map(w => `<option value="${w.id}">${w.name}</option>`).join('');

            const todayISO = formatDateISO(getVietnamToday());
            const matchedWeek = WEEKS_DATA.find(w => w.id !== 'all' && todayISO >= w.start && todayISO <= w.end);
            if (matchedWeek) {
                state.weekFilter = matchedWeek.id;
            } else {
                state.weekFilter = 'all';
            }
            select.value = state.weekFilter;
        }

        function setGroupFilter(groupKey) {
            state.groupFilter = groupKey;
            localStorage.setItem('rm3103_group', groupKey);

            ['all', 'nhom5', 'nhom6'].forEach(k => {
                const btn = document.getElementById(`group-btn-${k}`);
                if (k === groupKey) {
                    btn.className = 'group-filter-btn flex-1 sm:flex-initial px-3.5 py-2 rounded-lg text-xs sm:text-sm font-bold transition-all bg-blue-600 text-white shadow-sm';
                } else {
                    btn.className = 'group-filter-btn flex-1 sm:flex-initial px-3.5 py-2 rounded-lg text-xs sm:text-sm font-bold transition-all text-slate-600 dark:text-slate-300 hover:bg-slate-200/60 dark:hover:bg-slate-600/50';
                }
            });

            const labelMap = {
                'all': 'Cả lớp RM31.03 (27 SV)',
                'nhom5': 'Chỉ Nhóm 5 (14 SV)',
                'nhom6': 'Chỉ Nhóm 6 (13 SV)'
            };
            document.getElementById('widget-group-label').textContent = labelMap[groupKey];
            document.getElementById('ics-group-select').value = groupKey;

            renderAll();
        }

        function setWeekFilter(weekId) {
            state.weekFilter = weekId;
            document.getElementById('week-selector').value = weekId;
            renderAll();
        }

        function StepWeek(direction) {
            const currentIndex = WEEKS_DATA.findIndex(w => w.id === state.weekFilter);
            let nextIndex = currentIndex + direction;
            if (nextIndex < 0) nextIndex = WEEKS_DATA.length - 1;
            if (nextIndex >= WEEKS_DATA.length) nextIndex = 0;
            setWeekFilter(WEEKS_DATA[nextIndex].id);
        }

        function jumpToCurrentWeek() {
            const todayISO = formatDateISO(getVietnamToday());
            const matchedWeek = WEEKS_DATA.find(w => w.id !== 'all' && todayISO >= w.start && todayISO <= w.end);
            if (matchedWeek) {
                setWeekFilter(matchedWeek.id);
                showToast(`Đã chuyển về ${matchedWeek.name.split('•')[0].trim()}`, 'info');
            } else {
                setWeekFilter('all');
                showToast('Ngày hiện tại nằm ngoài khung 10 tuần học, hiển thị lịch tổng quát.', 'info');
            }
        }

        function setViewMode(mode) {
            state.viewMode = mode;
            const tableBtn = document.getElementById('view-btn-table');
            const cardBtn = document.getElementById('view-btn-card');
            const tableContainer = document.getElementById('table-view-container');
            const cardContainer = document.getElementById('card-view-container');

            if (mode === 'table') {
                tableBtn.className = 'view-mode-btn flex-1 sm:flex-initial px-3.5 py-2 rounded-lg text-xs sm:text-sm font-bold transition-all flex items-center justify-center gap-1.5 bg-blue-600 text-white shadow-sm';
                cardBtn.className = 'view-mode-btn flex-1 sm:flex-initial px-3.5 py-2 rounded-lg text-xs sm:text-sm font-bold transition-all flex items-center justify-center gap-1.5 text-slate-600 dark:text-slate-300 hover:bg-slate-200/60 dark:hover:bg-slate-600/50';
                tableContainer.classList.remove('hidden');
                cardContainer.classList.add('hidden');
            } else {
                cardBtn.className = 'view-mode-btn flex-1 sm:flex-initial px-3.5 py-2 rounded-lg text-xs sm:text-sm font-bold transition-all flex items-center justify-center gap-1.5 bg-blue-600 text-white shadow-sm';
                tableBtn.className = 'view-mode-btn flex-1 sm:flex-initial px-3.5 py-2 rounded-lg text-xs sm:text-sm font-bold transition-all flex items-center justify-center gap-1.5 text-slate-600 dark:text-slate-300 hover:bg-slate-200/60 dark:hover:bg-slate-600/50';
                tableContainer.classList.add('hidden');
                cardContainer.classList.remove('hidden');
            }
        }

        function toggleHideInactive(checked) {
            state.hideInactive = checked;
            renderScheduleViews();
        }

        // =========================================================================
        // 6. HIỂN THỊ BẢNG (TABLE VIEW) & THẺ (CARD VIEW)
        // =========================================================================
        function getDateForDayInSelectedWeek(offsetFromMonday) {
            if (state.weekFilter === 'all') return null;
            const weekObj = WEEKS_DATA.find(w => w.id === state.weekFilter);
            if (!weekObj) return null;
            const mondayDate = parseDateLocal(weekObj.start);
            return new Date(mondayDate.getFullYear(), mondayDate.getMonth(), mondayDate.getDate() + offsetFromMonday);
        }

        function renderWeekBanner() {
            const banner = document.getElementById('week-status-banner');
            const weekObj = WEEKS_DATA.find(w => w.id === state.weekFilter);
            const groupText = state.groupFilter === 'all' ? 'Cả lớp RM31.03 (27 SV)' : (state.groupFilter === 'nhom5' ? 'Nhóm 5 (14 SV) - RM31.03' : 'Nhóm 6 (13 SV) - RM31.03');

            document.getElementById('print-subtitle').textContent = `Đối tượng: ${groupText} | ${weekObj ? weekObj.name : ''}`;

            if (state.weekFilter === 'all') {
                banner.innerHTML = `
                    <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-blue-100 dark:bg-blue-900/50 text-blue-800 dark:text-blue-200 font-semibold">
                        <i class="fa-solid fa-layer-group mr-1.5"></i> Chế độ toàn kỳ
                    </span>
                    <span>Hiển thị tất cả các học phần trong Học kỳ I. Bấm vào huy hiệu <strong>Nhóm 5 / Nhóm 6</strong> trên thẻ môn học để xem danh sách SV.</span>
                `;
            } else {
                const wNum = Number(state.weekFilter);
                let noteHtml = '';
                if (wNum <= 2) {
                    noteHtml = `<span class="text-amber-600 dark:text-amber-400 font-semibold">• Lưu ý: Tuần ${wNum} chưa bắt đầu học Thực hành Giải phẫu (C402) và Thực hành Hóa học (C606).</span>`;
                } else if (wNum >= 3 && wNum <= 8) {
                    noteHtml = `<span class="text-emerald-600 dark:text-emerald-400 font-semibold">• Tuần ${wNum} học đầy đủ cả Lý thuyết và Thực hành.</span>`;
                } else if (wNum >= 9) {
                    noteHtml = `<span class="text-purple-600 dark:text-purple-400 font-semibold">• Lưu ý: LT Giải phẫu, TH Giải phẫu & LT Hóa học đã kết thúc (05/12). Chỉ còn TH Hóa học & các môn nhà A.</span>`;
                }
                banner.innerHTML = `
                    <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-teal-100 dark:bg-teal-900/50 text-teal-800 dark:text-teal-200 font-semibold">
                        <i class="fa-regular fa-calendar-days mr-1.5"></i> Đang xem Tuần ${wNum}
                    </span>
                    ${noteHtml}
                `;
            }
        }

        // Sinh HTML cho 1 thẻ môn học trong ô lịch (Tích hợp nút bấm xem DS nhóm khéo léo)
        function buildCourseCardHTML(item, specificDateObj) {
            const theme = THEME_STYLES[item.colorTheme] || THEME_STYLES.blue;
            const userNote = state.notes[item.id] || '';
            let statusInfo = null;

            if (specificDateObj) {
                statusInfo = evaluateItemStatusOnDate(item, formatDateISO(specificDateObj));
                if (!statusInfo.active && state.hideInactive) {
                    return '';
                }
            }

            const inactiveOpacity = (statusInfo && !statusInfo.active) ? 'opacity-50 grayscale-[35%]' : '';
            const titleStrike = (statusInfo && statusInfo.status === 'ended') ? 'line-through' : '';

            // Nếu môn học thuộc Nhóm 5, Nhóm 6 hoặc Cả lớp RM31.03, cho phép bấm vào huy hiệu nhóm để mở ngay Danh sách SV
            const groupBadgeHtml = item.rosterKey
                ? `<button type="button" onclick="event.stopPropagation(); openStudentModal('${item.rosterKey}')" title="Bấm để xem danh sách sinh viên ${item.groupBadge}" class="text-[11px] font-bold px-2 py-0.5 rounded-md ${theme.badgeBg} hover:ring-2 hover:ring-current transition inline-flex items-center gap-1">
                        <i class="fa-solid fa-users text-[9px] opacity-75"></i>
                        <span>${item.groupBadge}</span>
                   </button>`
                : `<span class="text-[11px] font-bold px-2 py-0.5 rounded-md ${theme.badgeBg}">
                        ${item.groupBadge}
                   </span>`;

            return `
                <div onclick="openNoteModal('${item.id}')" class="group relative rounded-xl p-3 border ${theme.bg} ${theme.border} ${inactiveOpacity} hover:shadow-md transition-all cursor-pointer text-left">
                    <!-- Dòng trên: Nhóm (Click mở DS) + Phòng học -->
                    <div class="flex items-center justify-between gap-1.5 mb-1.5">
                        ${groupBadgeHtml}
                        <span class="text-[11px] font-extrabold px-2 py-0.5 rounded-md ${theme.roomBg} shadow-sm">
                            ${item.room}
                        </span>
                    </div>

                    <!-- Tên môn học -->
                    <div class="font-bold text-sm ${theme.title} ${titleStrike} flex items-center gap-1.5">
                        <i class="fa-solid ${item.icon} text-xs opacity-80"></i>
                        <span>${item.subject}</span>
                    </div>

                    <!-- Số tiết & Thời gian -->
                    <div class="mt-1.5 text-[11px] text-slate-600 dark:text-slate-300 space-y-0.5">
                        <div class="flex items-center gap-1">
                            <i class="fa-regular fa-clock text-[10px] opacity-75"></i>
                            <span>${item.periods}</span>
                        </div>
                        <div class="flex items-center gap-1">
                            <i class="fa-regular fa-calendar text-[10px] opacity-75"></i>
                            <span>${item.durationText}</span>
                        </div>
                    </div>

                    <!-- Trạng thái theo tuần cụ thể -->
                    ${statusInfo ? `
                        <div class="mt-2 pt-1.5 border-t border-black/5 dark:border-white/10">
                            <span class="inline-block text-[10px] font-bold px-2 py-0.5 rounded-full ${statusInfo.badgeClass}">
                                ${statusInfo.badgeText}
                            </span>
                        </div>
                    ` : ''}

                    <!-- Ghi chú cá nhân nếu có -->
                    ${userNote ? `
                        <div class="mt-2 p-1.5 rounded-lg bg-yellow-100/90 dark:bg-yellow-900/50 border border-yellow-300 dark:border-yellow-700 text-[11px] text-yellow-900 dark:text-yellow-200 flex items-start gap-1.5">
                            <i class="fa-solid fa-thumbtack text-[10px] mt-0.5 text-amber-600 dark:text-amber-400 shrink-0"></i>
                            <span class="break-words font-medium">${escapeHtml(userNote)}</span>
                        </div>
                    ` : `
                        <div class="opacity-0 group-hover:opacity-100 transition-opacity mt-1.5 text-[10px] text-slate-400 dark:text-slate-400 flex items-center justify-between no-print">
                            <span><i class="fa-regular fa-pen-to-square"></i> Ghi chú</span>
                            ${item.rosterKey ? `<span><i class="fa-regular fa-address-book"></i> Bấm nhóm xem DS</span>` : ''}
                        </div>
                    `}
                </div>
            `;
        }

        function renderScheduleViews() {
            renderWeekBanner();

            const todayObj = getVietnamToday();
            const todayISO = formatDateISO(todayObj);
            const todayVNDay = getVNDayOfWeek(todayObj);

            const tableDays = DAYS_INFO.slice(0, 6); // T2 -> T7

            // 1. Render Header của Bảng
            const headerRow = document.getElementById('table-header-row');
            let headerHtml = `<th class="p-3.5 border-b border-r border-slate-200 dark:border-slate-700 w-24 text-center">Buổi</th>`;

            tableDays.forEach(d => {
                const colDateObj = getDateForDayInSelectedWeek(d.offsetFromMonday);
                const colDateISO = colDateObj ? formatDateISO(colDateObj) : null;
                const isTodayCol = (state.weekFilter === 'all' && d.dayOfWeek === todayVNDay) || (colDateISO === todayISO);

                headerHtml += `
                    <th class="p-3.5 border-b border-r border-slate-200 dark:border-slate-700 text-center w-[15%] ${isTodayCol ? 'today-col-header' : ''}">
                        <div class="flex flex-col items-center">
                            <span class="text-xs sm:text-sm font-extrabold text-slate-800 dark:text-white">${d.label}</span>
                            ${colDateObj ? `<span class="text-[11px] font-medium text-slate-500 dark:text-slate-400 mt-0.5">${formatDDMM(colDateObj)}/2026</span>` : ''}
                            ${isTodayCol ? `<span class="mt-1 px-2 py-0.5 rounded-full bg-blue-600 text-white text-[10px] font-bold tracking-wider uppercase shadow-sm">Hôm nay</span>` : ''}
                        </div>
                    </th>
                `;
            });
            headerRow.innerHTML = headerHtml;

            // 2. Render Body của Bảng (SÁNG & CHIỀU)
            const sessions = [
                { key: 'SÁNG', label: 'SÁNG', sub: 'Ca sáng', icon: 'fa-sun text-amber-500' },
                { key: 'CHIỀU', label: 'CHIỀU', sub: 'Ca chiều', icon: 'fa-cloud-sun text-blue-500' }
            ];

            const tbody = document.getElementById('table-body');
            let bodyHtml = '';

            sessions.forEach(sess => {
                bodyHtml += `<tr class="divide-x divide-slate-200 dark:divide-slate-700">`;
                bodyHtml += `
                    <td class="p-3 bg-slate-50/90 dark:bg-slate-800/90 text-center align-middle font-bold text-slate-700 dark:text-slate-200">
                        <div class="flex flex-col items-center justify-center gap-1">
                            <i class="fa-solid ${sess.icon} text-base"></i>
                            <span class="text-xs tracking-wider">${sess.label}</span>
                        </div>
                    </td>
                `;

                tableDays.forEach(d => {
                    const colDateObj = getDateForDayInSelectedWeek(d.offsetFromMonday);
                    const colDateISO = colDateObj ? formatDateISO(colDateObj) : null;
                    const isTodayCol = (state.weekFilter === 'all' && d.dayOfWeek === todayVNDay) || (colDateISO === todayISO);

                    const matchingItems = SCHEDULE_ITEMS.filter(item => {
                        if (item.dayOfWeek !== d.dayOfWeek || item.session !== sess.key) return false;
                        if (state.groupFilter === 'all') return true;
                        return item.groups.includes(state.groupFilter);
                    });

                    const cardsHtml = matchingItems
                        .map(item => buildCourseCardHTML(item, colDateObj))
                        .filter(Boolean)
                        .join('');

                    bodyHtml += `
                        <td class="p-2.5 align-top ${isTodayCol ? 'today-col-cell' : ''}">
                            ${cardsHtml ? `<div class="space-y-2.5">${cardsHtml}</div>` : `
                                <div class="h-full min-h-[76px] flex items-center justify-center text-xs text-slate-400 dark:text-slate-600 italic select-none">
                                    Nghỉ
                                </div>
                            `}
                        </td>
                    `;
                });

                bodyHtml += `</tr>`;
            });
            tbody.innerHTML = bodyHtml;

            // 3. Render Chế độ Thẻ từng ngày (Card / Agenda View)
            const cardContainer = document.getElementById('card-view-container');
            let cardsViewHtml = '';

            DAYS_INFO.forEach(d => {
                const colDateObj = getDateForDayInSelectedWeek(d.offsetFromMonday);
                const colDateISO = colDateObj ? formatDateISO(colDateObj) : null;
                const isTodayCard = (state.weekFilter === 'all' && d.dayOfWeek === todayVNDay) || (colDateISO === todayISO);

                const morningItems = SCHEDULE_ITEMS.filter(item => {
                    if (item.dayOfWeek !== d.dayOfWeek || item.session !== 'SÁNG') return false;
                    return state.groupFilter === 'all' || item.groups.includes(state.groupFilter);
                });
                const afternoonItems = SCHEDULE_ITEMS.filter(item => {
                    if (item.dayOfWeek !== d.dayOfWeek || item.session !== 'CHIỀU') return false;
                    return state.groupFilter === 'all' || item.groups.includes(state.groupFilter);
                });

                const morningHtml = morningItems.map(it => buildCourseCardHTML(it, colDateObj)).filter(Boolean).join('');
                const afternoonHtml = afternoonItems.map(it => buildCourseCardHTML(it, colDateObj)).filter(Boolean).join('');

                if (d.dayOfWeek === 8) {
                    cardsViewHtml += `
                        <div class="rounded-2xl bg-white dark:bg-slate-800 border ${isTodayCard ? 'border-blue-500 ring-2 ring-blue-500/20' : 'border-slate-200 dark:border-slate-700'} p-4 shadow-sm flex items-center justify-between">
                            <div class="flex items-center gap-2.5">
                                <span class="w-9 h-9 rounded-xl bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 font-bold text-xs flex items-center justify-center">CN</span>
                                <div>
                                    <h4 class="font-bold text-sm text-slate-800 dark:text-white">${d.label} ${colDateObj ? `(${formatDDMM(colDateObj)})` : ''}</h4>
                                    <p class="text-xs text-slate-500 dark:text-slate-400">Nghỉ cả ngày</p>
                                </div>
                            </div>
                            <span class="text-xs px-2.5 py-1 rounded-full bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300 font-semibold">Cuối tuần</span>
                        </div>
                    `;
                    return;
                }

                cardsViewHtml += `
                    <div class="rounded-2xl bg-white dark:bg-slate-800 border ${isTodayCard ? 'border-blue-500 ring-2 ring-blue-500/20' : 'border-slate-200 dark:border-slate-700'} overflow-hidden shadow-sm flex flex-col">
                        <div class="px-4 py-3 ${isTodayCard ? 'bg-blue-600 text-white' : 'bg-slate-100/80 dark:bg-slate-700/70 text-slate-800 dark:text-white'} flex items-center justify-between border-b border-slate-200/70 dark:border-slate-700">
                            <div class="flex items-center gap-2">
                                <span class="font-extrabold text-sm sm:text-base">${d.label}</span>
                                ${colDateObj ? `<span class="text-xs opacity-85 font-medium">(${formatDDMM(colDateObj)}/2026)</span>` : ''}
                            </div>
                            ${isTodayCard ? `<span class="px-2 py-0.5 rounded-full bg-white text-blue-700 text-[10px] font-extrabold uppercase">Hôm nay</span>` : ''}
                        </div>

                        <div class="p-4 space-y-4 flex-1">
                            <!-- Buổi sáng -->
                            <div>
                                <div class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-400 mb-2 flex items-center gap-1.5">
                                    <i class="fa-solid fa-sun text-amber-500"></i> Buổi Sáng
                                </div>
                                ${morningHtml ? `<div class="space-y-2">${morningHtml}</div>` : `<div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-700/30 text-xs text-slate-400 italic text-center">Nghỉ buổi sáng</div>`}
                            </div>

                            <!-- Buổi chiều -->
                            <div>
                                <div class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-400 mb-2 flex items-center gap-1.5">
                                    <i class="fa-solid fa-cloud-sun text-blue-500"></i> Buổi Chiều
                                </div>
                                ${afternoonHtml ? `<div class="space-y-2">${afternoonHtml}</div>` : `<div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-700/30 text-xs text-slate-400 italic text-center">Nghỉ buổi chiều</div>`}
                            </div>
                        </div>
                    </div>
                `;
            });

            cardContainer.innerHTML = cardsViewHtml;
        }

        // =========================================================================
        // 7. WIDGET HÔM NAY & NGÀY MAI HỌC GÌ?
        // =========================================================================
        function updateTodayTomorrowWidget(customDateISO) {
            const baseDate = customDateISO ? parseDateLocal(customDateISO) : getVietnamToday();
            state.referenceDateStr = formatDateISO(baseDate);
            document.getElementById('custom-date-picker').value = state.referenceDateStr;

            const tomorrowDate = new Date(baseDate.getFullYear(), baseDate.getMonth(), baseDate.getDate() + 1);

            renderSingleDaySummary(baseDate, 'today-title-date', 'today-schedule-list');
            renderSingleDaySummary(tomorrowDate, 'tomorrow-title-date', 'tomorrow-schedule-list');
        }

        function resetDatePickerToToday() {
            const todayISO = formatDateISO(getVietnamToday());
            updateTodayTomorrowWidget(todayISO);
            showToast('Đã đặt lại ngày tra cứu về hôm nay.', 'info');
        }

        function renderSingleDaySummary(dateObj, titleElemId, listElemId) {
            const vnDay = getVNDayOfWeek(dateObj);
            const dayInfo = DAYS_INFO.find(d => d.dayOfWeek === vnDay);
            const dateISO = formatDateISO(dateObj);

            document.getElementById(titleElemId).textContent = `${dayInfo.label}, ${formatDDMMYYYY(dateISO)}`;

            const dayItems = SCHEDULE_ITEMS.filter(item => {
                if (item.dayOfWeek !== vnDay) return false;
                return state.groupFilter === 'all' || item.groups.includes(state.groupFilter);
            });

            const container = document.getElementById(listElemId);
            if (dayItems.length === 0) {
                container.innerHTML = `
                    <div class="p-3 rounded-xl bg-white/80 dark:bg-slate-800/80 border border-slate-200/60 dark:border-slate-700 text-xs sm:text-sm text-slate-500 dark:text-slate-400 flex items-center gap-2">
                        <i class="fa-solid fa-mug-hot text-emerald-500"></i>
                        <span>Nghỉ cả ngày – Không có lịch học cố định.</span>
                    </div>
                `;
                return;
            }

            container.innerHTML = dayItems.map(item => {
                const statusObj = evaluateItemStatusOnDate(item, dateISO);
                const theme = THEME_STYLES[item.colorTheme] || THEME_STYLES.blue;
                return `
                    <div onclick="openNoteModal('${item.id}')" class="p-3 rounded-xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-2 cursor-pointer hover:border-blue-400 transition">
                        <div class="flex items-start gap-2.5">
                            <span class="px-2 py-1 rounded-lg text-[10px] font-extrabold uppercase ${item.session === 'SÁNG' ? 'bg-amber-100 text-amber-800 dark:bg-amber-900/60 dark:text-amber-200' : 'bg-blue-100 text-blue-800 dark:bg-blue-900/60 dark:text-blue-200'} shrink-0 mt-0.5">
                                ${item.session}
                            </span>
                            <div>
                                <div class="font-bold text-xs sm:text-sm text-slate-800 dark:text-white flex flex-wrap items-center gap-1.5">
                                    <span>${item.subject}</span>
                                    <span class="text-[10px] px-1.5 py-0.5 rounded ${theme.badgeBg}">${item.groupBadge}</span>
                                </div>
                                <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                                    <strong>${item.room}</strong> • ${item.periods}
                                </div>
                            </div>
                        </div>
                        <span class="self-start sm:self-center text-[10px] font-bold px-2.5 py-1 rounded-full shrink-0 ${statusObj.badgeClass}">
                            ${statusObj.badgeText}
                        </span>
                    </div>
                `;
            }).join('');
        }

        function copyDaySchedule(which) {
            const baseDate = state.referenceDateStr ? parseDateLocal(state.referenceDateStr) : getVietnamToday();
            const targetDate = which === 'today' ? baseDate : new Date(baseDate.getFullYear(), baseDate.getMonth(), baseDate.getDate() + 1);
            const vnDay = getVNDayOfWeek(targetDate);
            const dayInfo = DAYS_INFO.find(d => d.dayOfWeek === vnDay);
            const dateISO = formatDateISO(targetDate);

            const groupName = state.groupFilter === 'all' ? 'Lớp RM31.03 (N5 & N6)' : (state.groupFilter === 'nhom5' ? 'Nhóm 5 - RM31.03' : 'Nhóm 6 - RM31.03');
            const items = SCHEDULE_ITEMS.filter(item => item.dayOfWeek === vnDay && (state.groupFilter === 'all' || item.groups.includes(state.groupFilter)));

            let text = `📅 LỊCH HỌC ${groupName.toUpperCase()} - ${dayInfo.label.toUpperCase()} (${formatDDMMYYYY(dateISO)}):\n`;
            if (items.length === 0) {
                text += `• Nghỉ cả ngày.`;
            } else {
                items.forEach(it => {
                    const st = evaluateItemStatusOnDate(it, dateISO);
                    text += `• Buổi ${it.session}: ${it.subject} (${it.groupBadge}) | ${it.room} | ${it.periods} [${st.badgeText}]\n`;
                });
            }

            copyTextToClipboard(text.trim());
            showToast('Đã sao chép lịch học vào bộ nhớ tạm!', 'success');
        }

        function copyTextToClipboard(text) {
            const textarea = document.createElement('textarea');
            textarea.value = text;
            textarea.style.position = 'fixed';
            textarea.style.opacity = '0';
            document.body.appendChild(textarea);
            textarea.select();
            try {
                document.execCommand('copy');
            } catch (err) {
                console.error('Copy error:', err);
            }
            document.body.removeChild(textarea);
        }

        // =========================================================================
        // 8. QUẢN LÝ GHI CHÚ CÁ NHÂN (LOCALSTORAGE)
        // =========================================================================
        function openNoteModal(itemId) {
            const item = SCHEDULE_ITEMS.find(i => i.id === itemId);
            if (!item) return;
            state.activeNoteItemId = itemId;
            const dayInfo = DAYS_INFO.find(d => d.dayOfWeek === item.dayOfWeek);

            document.getElementById('note-modal-title').innerHTML = `<i class="fa-regular fa-pen-to-square text-blue-500"></i> ${item.subject}`;
            document.getElementById('note-modal-subtitle').textContent = `${dayInfo.label} (Buổi ${item.session}) • ${item.room} • ${item.groupBadge}`;
            document.getElementById('note-modal-input').value = state.notes[itemId] || '';
            document.getElementById('note-modal').classList.remove('hidden');
            setTimeout(() => document.getElementById('note-modal-input').focus(), 50);
        }

        function closeNoteModal() {
            document.getElementById('note-modal').classList.add('hidden');
            state.activeNoteItemId = null;
        }

        function appendQuickNote(sampleText) {
            const input = document.getElementById('note-modal-input');
            const current = input.value.trim();
            input.value = current ? `${current}; ${sampleText}` : sampleText;
            input.focus();
        }

        function saveNoteFromModal() {
            if (!state.activeNoteItemId) return;
            const val = document.getElementById('note-modal-input').value.trim();
            if (val) {
                state.notes[state.activeNoteItemId] = val;
                showToast('Đã lưu ghi chú môn học!', 'success');
            } else {
                delete state.notes[state.activeNoteItemId];
                showToast('Đã xóa ghi chú.', 'info');
            }
            localStorage.setItem('rm3103_notes', JSON.stringify(state.notes));
            closeNoteModal();
            renderAll();
        }

        function deleteCurrentNote() {
            if (!state.activeNoteItemId) return;
            delete state.notes[state.activeNoteItemId];
            localStorage.setItem('rm3103_notes', JSON.stringify(state.notes));
            closeNoteModal();
            renderAll();
            showToast('Đã xóa ghi chú môn học.', 'info');
        }

        function clearAllNotes() {
            state.notes = {};
            localStorage.removeItem('rm3103_notes');
            renderAll();
            showToast('Đã xóa toàn bộ ghi chú cá nhân.', 'info');
        }

        function renderSavedNotesList() {
            const listEl = document.getElementById('saved-notes-list');
            const clearBtn = document.getElementById('clear-notes-btn');
            const noteKeys = Object.keys(state.notes);

            if (noteKeys.length === 0) {
                clearBtn.classList.add('hidden');
                listEl.innerHTML = `
                    <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-700/30 border border-dashed border-slate-200 dark:border-slate-700 text-center text-xs text-slate-400">
                        Chưa có ghi chú nào. Bạn có thể bấm vào bất kỳ ô môn học nào trên bảng để thêm lời nhắc (VD: mang áo blouse, lịch kiểm tra).
                    </div>
                `;
                return;
            }

            clearBtn.classList.remove('hidden');
            listEl.innerHTML = noteKeys.map(itemId => {
                const item = SCHEDULE_ITEMS.find(i => i.id === itemId);
                if (!item) return '';
                const dayInfo = DAYS_INFO.find(d => d.dayOfWeek === item.dayOfWeek);
                return `
                    <div onclick="openNoteModal('${item.id}')" class="p-2.5 rounded-xl bg-amber-50/70 dark:bg-amber-950/30 border border-amber-200/80 dark:border-amber-800/60 cursor-pointer hover:shadow-sm transition text-xs">
                        <div class="flex items-center justify-between font-bold text-amber-900 dark:text-amber-300">
                            <span>${item.subject} (${item.groupBadge})</span>
                            <span class="text-[10px] text-slate-500 dark:text-slate-400">${dayInfo.shortLabel} - ${item.session}</span>
                        </div>
                        <p class="text-slate-700 dark:text-slate-200 mt-1 break-words">${escapeHtml(state.notes[itemId])}</p>
                    </div>
                `;
            }).join('');
        }

        // =========================================================================
        // 9. XUẤT LỊCH SANG FILE .ICS (GOOGLE / APPLE CALENDAR)
        // =========================================================================
        function openExportModal() {
            document.getElementById('ics-group-select').value = state.groupFilter;
            document.getElementById('export-modal').classList.remove('hidden');
        }

        function closeExportModal() {
            document.getElementById('export-modal').classList.add('hidden');
        }

        function downloadICSFile() {
            const targetGroup = document.getElementById('ics-group-select').value;
            const filteredItems = SCHEDULE_ITEMS.filter(item => targetGroup === 'all' || item.groups.includes(targetGroup));

            let icsLines = [
                'BEGIN:VCALENDAR',
                'VERSION:2.0',
                'PRODID:-//HUBT Khoa Răng Hàm Mặt//Lich Hoc RM31.03//VI',
                'CALSCALE:GREGORIAN',
                'METHOD:PUBLISH'
            ];

            filteredItems.forEach(item => {
                const startObj = parseDateLocal(item.startDate);
                const endObj = parseDateLocal(item.endDate);

                let cursor = new Date(startObj.getFullYear(), startObj.getMonth(), startObj.getDate());
                while (getVNDayOfWeek(cursor) !== item.dayOfWeek) {
                    cursor.setDate(cursor.getDate() + 1);
                }

                const startTimeStr = item.session === 'SÁNG' ? '073000' : '130000';
                const endTimeStr = item.session === 'SÁNG' ? '113000' : '170000';

                while (cursor <= endObj) {
                    const y = cursor.getFullYear();
                    const m = String(cursor.getMonth() + 1).padStart(2, '0');
                    const d = String(cursor.getDate()).padStart(2, '0');
                    const datePart = `${y}${m}${d}`;

                    const summary = `[${item.shortCode}] ${item.subject} - ${item.room} (${item.groupBadge})`;
                    const noteText = state.notes[item.id] ? ` | Ghi chú: ${state.notes[item.id]}` : '';
                    const desc = `Lớp RM31.03 - Khoa Răng Hàm Mặt HUBT | Thời lượng: ${item.periods} | ${item.durationText}${noteText}`;

                    icsLines.push(
                        'BEGIN:VEVENT',
                        `UID:${item.id}-${datePart}@rm3103.hubt.edu.vn`,
                        `DTSTAMP:${datePart}T000000Z`,
                        `DTSTART;TZID=Asia/Ho_Chi_Minh:${datePart}T${startTimeStr}`,
                        `DTEND;TZID=Asia/Ho_Chi_Minh:${datePart}T${endTimeStr}`,
                        `SUMMARY:${summary}`,
                        `LOCATION:${item.room} - Khoa Răng Hàm Mặt HUBT`,
                        `DESCRIPTION:${desc}`,
                        'END:VEVENT'
                    );

                    cursor.setDate(cursor.getDate() + 7);
                }
            });

            icsLines.push('END:VCALENDAR');

            const blob = new Blob([icsLines.join('\r\n')], { type: 'text/calendar;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            const fileSuffix = targetGroup === 'all' ? 'CaLop' : (targetGroup === 'nhom5' ? 'Nhom5' : 'Nhom6');
            a.download = `LichHoc_RM31.03_${fileSuffix}_HK1_2026.ics`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);

            closeExportModal();
            showToast('Đã tải file lịch .ICS thành công!', 'success');
        }

        // =========================================================================
        // 10. DARK MODE, TOAST & KHỞI ĐỘNG ỨNG DỤNG
        // =========================================================================
        function initTheme() {
            const savedTheme = localStorage.getItem('rm3103_theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
                document.documentElement.classList.add('dark');
                document.getElementById('theme-icon').className = 'fa-solid fa-sun text-amber-300 text-sm sm:text-base';
            } else {
                document.documentElement.classList.remove('dark');
                document.getElementById('theme-icon').className = 'fa-solid fa-moon text-sm sm:text-base';
            }
        }

        function toggleDarkMode() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('rm3103_theme', isDark ? 'dark' : 'light');
            document.getElementById('theme-icon').className = isDark
                ? 'fa-solid fa-sun text-amber-300 text-sm sm:text-base'
                : 'fa-solid fa-moon text-sm sm:text-base';
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            const colorMap = {
                success: 'bg-emerald-600 text-white',
                info: 'bg-slate-800 dark:bg-slate-700 text-white'
            };
            toast.className = `pointer-events-auto px-4 py-2.5 rounded-xl shadow-lg text-xs sm:text-sm font-semibold flex items-center gap-2 transition-all duration-300 ${colorMap[type] || colorMap.info}`;
            toast.innerHTML = `<i class="fa-solid ${type === 'success' ? 'fa-circle-check' : 'fa-circle-info'}"></i><span>${escapeHtml(message)}</span>`;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(8px)';
                setTimeout(() => toast.remove(), 300);
            }, 2800);
        }

        function escapeHtml(str) {
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function updateLiveHeaderClock() {
            const today = getVietnamToday();
            const vnDay = getVNDayOfWeek(today);
            const dayInfo = DAYS_INFO.find(d => d.dayOfWeek === vnDay);
            const dateISO = formatDateISO(today);
            document.getElementById('live-date-badge').textContent = `${dayInfo.label}, ${formatDDMMYYYY(dateISO)}`;
        }

        function renderAll() {
            renderPersonalStudentBanner();
            renderScheduleViews();
            updateTodayTomorrowWidget(state.referenceDateStr);
            renderSavedNotesList();
        }

        window.onload = function () {
            initTheme();
            updateLiveHeaderClock();
            initWeekSelector();
            setViewMode(state.viewMode);

            // Nếu đã chọn sinh viên cá nhân trước đó, đồng bộ nhóm theo sinh viên đó
            if (state.myStudentId) {
                const st = STUDENTS_DATA.find(s => s.id === state.myStudentId);
                if (st) state.groupFilter = st.group;
            }
            setGroupFilter(state.groupFilter);
        };
    </script>
