                        <button id="theme-toggle-btn" onclick="toggleDarkMode()" title="Chế độ Sáng / Tối" class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-white/15 hover:bg-white/25 active:scale-95 transition flex items-center justify-center border border-white/20">
                            <i id="theme-icon" class="fa-solid fa-moon text-sm sm:text-base"></i>
