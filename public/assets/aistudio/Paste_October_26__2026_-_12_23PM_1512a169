        // Loại bỏ dấu tiếng Việt để tìm kiếm thông minh
        function removeVietnameseTones(str) {
            return String(str)
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .replace(/đ/g, 'd')
                .replace(/Đ/g, 'D')
                .toLowerCase();
        }

        function parseDateLocal(yyyy_mm_dd) {
            const [y, m, d] = yyyy_mm_dd.split('-').map(Number);
            return new Date(y, m - 1, d);
        }

        function formatDateISO(dateObj) {
            const y = dateObj.getFullYear();
            const m = String(dateObj.getMonth() + 1).padStart(2, '0');
            const d = String(dateObj.getDate()).padStart(2, '0');
            return `${y}-${m}-${d}`;
        }

        function formatDDMM(dateObj) {
            const d = String(dateObj.getDate()).padStart(2, '0');
            const m = String(dateObj.getMonth() + 1).padStart(2, '0');
            return `${d}/${m}`;
        }

        function formatDDMMYYYY(yyyy_mm_dd) {
            const [y, m, d] = yyyy_mm_dd.split('-');
            return `${d}/${m}/${y}`;
        }

        function getVietnamToday() {
            const now = new Date();
            const vnString = now.toLocaleString('en-US', { timeZone: 'Asia/Ho_Chi_Minh' });
            const vnDate = new Date(vnString);
            return new Date(vnDate.getFullYear(), vnDate.getMonth(), vnDate.getDate());
        }

        function getVNDayOfWeek(dateObj) {
            const jsDay = dateObj.getDay();
            return jsDay === 0 ? 8 : jsDay + 1;
        }

        function evaluateItemStatusOnDate(item, targetDateStr) {
            const targetDate = parseDateLocal(targetDateStr);
            const startDate = parseDateLocal(item.startDate);
            const endDate = parseDateLocal(item.endDate);

            if (targetDate < startDate) {
                return {
                    status: 'upcoming',
                    active: false,
                    badgeText: `Chưa bắt đầu (Học từ ${formatDDMM(startDate)})`,
                    badgeClass: 'bg-amber-100 text-amber-800 dark:bg-amber-900/60 dark:text-amber-200 border border-amber-300 dark:border-amber-700'
                };
            }
            if (targetDate > endDate) {
                return {
                    status: 'ended',
                    active: false,
                    badgeText: `Đã kết thúc (${formatDDMM(endDate)})`,
                    badgeClass: 'bg-slate-200 text-slate-600 dark:bg-slate-700 dark:text-slate-400 border border-slate-300 dark:border-slate-600'
                };
            }

            if (item.totalWeeks) {
                const diffDays = Math.floor((targetDate - startDate) / (1000 * 60 * 60 * 24));
                const weekNum = Math.floor(diffDays / 7) + 1;
                return {
                    status: 'active',
                    active: true,
                    badgeText: `Đang học • Buổi ${weekNum}/${item.totalWeeks}`,
                    badgeClass: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/60 dark:text-emerald-200 border border-emerald-300 dark:border-emerald-700'
                };
            }

            return {
                status: 'active',
                active: true,
                badgeText: 'Đang học tuần này',
                badgeClass: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/60 dark:text-emerald-200 border border-emerald-300 dark:border-emerald-700'
            };
        }

