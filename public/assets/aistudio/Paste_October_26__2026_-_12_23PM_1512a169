                    <button onclick="resetDatePickerToToday()" class="text-blue-600 dark:text-blue-400 hover:underline font-medium">Hôm nay</button>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Hôm nay -->
                <div class="rounded-xl bg-gradient-to-br from-blue-50/90 to-indigo-50/50 dark:from-slate-700/60 dark:to-slate-800 p-4 border border-blue-200/70 dark:border-slate-600">
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-2">
