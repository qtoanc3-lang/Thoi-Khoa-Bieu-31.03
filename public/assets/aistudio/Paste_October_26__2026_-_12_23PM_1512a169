                        <button id="view-btn-table" onclick="setViewMode('table')" class="view-mode-btn flex-1 sm:flex-initial px-3.5 py-2 rounded-lg text-xs sm:text-sm font-bold transition-all flex items-center justify-center gap-1.5">
