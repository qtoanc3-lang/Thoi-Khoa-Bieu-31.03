    <!-- HEADER -->
    <header class="bg-gradient-to-r from-blue-800 via-blue-700 to-teal-600 dark:from-slate-800 dark:via-blue-950 dark:to-teal-950 text-white shadow-lg border-b border-white/10">
        <div class="max-w-7xl mx-auto px-4 py-5 sm:px-6 lg:px-8">
