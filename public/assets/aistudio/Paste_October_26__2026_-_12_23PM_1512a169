        <div id="personal-student-banner" class="hidden bg-gradient-to-r from-teal-600 to-blue-600 text-white rounded-2xl p-3.5 sm:px-5 shadow-md flex flex-col sm:flex-row sm:items-center justify-between gap-3 no-print">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center font-extrabold text-sm shrink-0">
                    <i class="fa-solid fa-user-check text-lg"></i>
                </div>
                <div>
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="text-xs uppercase tracking-wider font-bold text-teal-100">Chế độ cá nhân hóa:</span>
                        <span id="personal-student-name" class="font-extrabold text-sm sm:text-base"></span>
                        <span id="personal-student-id" class="text-xs px-2 py-0.5 rounded-md bg-black/25 font-mono"></span>
