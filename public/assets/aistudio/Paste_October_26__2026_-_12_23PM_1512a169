                        <button onclick="window.print()" title="In Thời khóa biểu chuẩn A4" class="px-3 py-2 rounded-xl bg-white/15 hover:bg-white/25 active:scale-95 transition text-xs sm:text-sm font-semibold flex items-center gap-1.5 border border-white/20">
