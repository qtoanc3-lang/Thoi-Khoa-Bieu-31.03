                </div>

                <!-- Cụm nút tiện ích nhanh & Đồng hồ -->
                <div class="flex flex-wrap items-center gap-2 w-full lg:w-auto justify-between lg:justify-end no-print">
                    <div class="bg-black/20 backdrop-blur-md px-3.5 py-2 rounded-xl border border-white/15 text-xs sm:text-sm flex items-center gap-2">
                        <i class="fa-regular fa-clock text-teal-300"></i>
                        <span id="live-date-badge" class="font-medium">Đang tải ngày...</span>
                    </div>

                    <div class="flex items-center gap-2">
                        <!-- Nút mở Danh sách nhóm khéo léo trên thanh công cụ -->
                        <button onclick="openStudentModal('all')" title="Tra cứu Danh sách sinh viên Nhóm 5 & Nhóm 6" class="px-3.5 py-2 rounded-xl bg-teal-500/30 hover:bg-teal-500/45 active:scale-95 transition text-xs sm:text-sm font-bold flex items-center gap-1.5 border border-teal-300/40 shadow-sm">
                            <i class="fa-solid fa-address-book text-teal-200"></i>
                            <span>Danh sách nhóm</span>
                            <span class="px-1.5 py-0.2 rounded-md bg-white/20 text-[11px]">27</span>
                        </button>
                        <button onclick="openExportModal()" title="Xuất lịch sang Google/Apple Calendar (.ics)" class="px-3 py-2 rounded-xl bg-white/15 hover:bg-white/25 active:scale-95 transition text-xs sm:text-sm font-semibold flex items-center gap-1.5 border border-white/20">
